CONFIG_VENDOR=SERCOMM
CONFIG_PRODUCT=MT7620
CONFIG_FIRMWARE_PRODUCT_ID="RT-S1010"

### Настройки со скриншота (РАБОЧИЕ)
CONFIG_FIRMWARE_CPU_600MHZ=y
CONFIG_FIRMWARE_WIFI2_DRIVER=2.4
CONFIG_FIRMWARE_WIFI5_DRIVER=3.0
CONFIG_FIRMWARE_INCLUDE_XFRM=y
CONFIG_FIRMWARE_INCLUDE_IPSET=y
CONFIG_FIRMWARE_INCLUDE_SHORTCUT_FE=y

### Твои дополнения (БЕЗ HTTPS)
CONFIG_FIRMWARE_INCLUDE_NFQWS=y
CONFIG_FIRMWARE_INCLUDE_AMNEZIAWG=y
CONFIG_FIRMWARE_INCLUDE_DOH=y
CONFIG_FIRMWARE_INCLUDE_PRIVOXY=y

### Модули ядра для NFQWS (со скриншота)
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_IP_NF_QUEUE=y

### ТЕ САМЫЕ СТРОКИ (Разбор сомнений):
# Если ты ОЧЕНЬ боишься, можешь закомментировать их, НО:
# 1. Без CA_CERT не будет работать DoH.
# 2. Без EXTRA у Zapret не будет работать обход по TTL (Стратегия 6).
CONFIG_FIRMWARE_INCLUDE_CA_CERT=y
CONFIG_FIRMWARE_INCLUDE_NETFILTER_MOD_EXTRA=y
# TPROXY можно убрать, если не будешь делать "прозрачный" Privoxy.
# CONFIG_FIRMWARE_INCLUDE_NETFILTER_MOD_TPROXY=y

### Системное
CONFIG_FIRMWARE_INCLUDE_ZRAM=y
CONFIG_FIRMWARE_INCLUDE_LANG_RU=y
CONFIG_FIRMWARE_INCLUDE_CURL=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

### ОТКЛЮЧАЕМ ВСЁ ТЯЖЕЛОЕ (чтобы точно загрузилось)
#CONFIG_FIRMWARE_INCLUDE_TOR=n
#CONFIG_FIRMWARE_INCLUDE_HTTPS=n
#CONFIG_FIRMWARE_INCLUDE_QUIC=n
#CONFIG_FIRMWARE_INCLUDE_XUPNPD=n
